VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Requis uniquement pour lancer `npm run scan` en local (scripts/vinted-scan.ts).
# market_opportunities n'accepte plus les ecritures anonymes (voir DATABASE.md) --
# sans cette cle le scan echouera silencieusement a l'insertion.
SUPABASE_SERVICE_ROLE_KEY=

# Id de l'extension Chrome ResellOS (extension/), pour l'appairage depuis
# VintedAccountPage.tsx (voir src/lib/extensionBridge.ts). Correctif
# 2026-08-10 (diagnostic beta Albin) : cet ID est desormais STABLE -- calcule
# a partir de la cle publique embarquee dans extension/manifest.config.ts
# (champ `key`), identique pour tout le monde, sur toute machine, quel que
# soit le dossier d'installation (avant ce correctif, une extension chargee
# via "Charger l'extension non empaquetee" SANS cette cle obtenait un ID
# different par machine/emplacement, calcule par Chrome a partir du chemin
# absolu du dossier -- c'est ce qui cassait la detection pour tout
# beta-testeur autre que la machine de dev d'origine). Visible sur
# chrome://extensions une fois l'extension chargee. Ne change PAS a chaque
# re-chargement. Changera une seule fois, plus tard, lors de la premiere
# publication sur le Chrome Web Store (Google assigne alors son propre ID
# final, independant de cette cle) -- mise a jour a faire a ce moment-la.
VITE_RESELLOS_EXTENSION_ID=
